# Copy to terraform.tfvars and edit.

project_name = "unicode-to-java"
aws_region   = "ap-south-1"

# Leave domain_name empty to deploy on the default *.cloudfront.net URL first
# and attach a custom domain later.
domain_name               = "example.com"
subject_alternative_names = ["www.example.com"]

# Set only if the hosted zone lives in Route 53. When empty, Terraform creates
# the certificate but you add the validation and alias records yourself.
route53_zone_name = "example.com"

# true  -> 403/404 rewritten to /index.html with a 200 (React, Vue, Angular)
# false -> real 404s stay 404s (Hugo, Astro, plain HTML)
spa_mode = true

price_class    = "PriceClass_100"
enable_logging = false
force_destroy  = false
